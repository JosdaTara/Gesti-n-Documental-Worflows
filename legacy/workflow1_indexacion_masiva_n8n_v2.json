      "typeVersion": 1,
      "position": [
        0,
        440
      ]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "searchMethod": "name",
        "queryString": "",
        "returnAll": true,
        "filter": {
          "folderId": {
            "__rl": true,
            "value": "ID_DE_LA_CARPETA_DE_DRIVE",
            "mode": "id"
          },
          "whatToSearch": "files"
        },
