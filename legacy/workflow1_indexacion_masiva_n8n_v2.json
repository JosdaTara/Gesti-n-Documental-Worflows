    {
      "parameters": {
        "jsCode": "const t=String($input.first().json.pageContent||'');\nreturn [{json:{texto:t.slice(0,8000),vacio:!t.trim()}}];"
      },
      "id": "n-trim",
      "name": "Recortar texto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        700
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents:[{ role:'user', parts:[{ text: 'Clasifica y resume este documento para un repositorio documental.\\n\\nReglas:\\n- categoria: exactamente una de estas opciones: Contrato, Factura, Informe, Otro\\n- resumen: 2 o 3 frases en español con lo esencial del documento\\n- datos: objeto con hasta 5 campos clave (por ejemplo Partes, Vigencia, Valor, Numero, Periodo, Fecha)\\n\\nDevuelve SOLO un JSON valido con las claves categoria, resumen y datos.\\n\\nDocumento:\\n' + $json.texto }]}], generationConfig:{ temperature:0.2, responseMimeType:'application/json' } }) }}",
        "options": {}
      },
      "id": "n-gemini",
      "name": "Clasificar con Gemini",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        700
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const loop=$('Loop Over Items').first().json;\nlet categoria='',resumen='',datos='',detalle='';\ntry{\n  if($json.vacio)throw new Error('no se pudo extraer texto del archivo');\n  const c=$json.candidates;\n  const raw=(Array.isArray(c)&&c[0]&&c[0].content&&Array.isArray(c[0].content.parts))?c[0].content.parts.map(p=>(p&&p.text)||'').join('').trim():'';\n  if(!raw)throw new Error('Gemini no devolvio contenido');\n  const o=JSON.parse(raw);\n  const validas=['Contrato','Factura','Informe','Otro'];\n  categoria=validas.includes(o.categoria)?o.categoria:'Otro';\n  resumen=String(o.resumen||'').slice(0,800);\n  if(o.datos&&typeof o.datos==='object')datos=JSON.stringify(o.datos).slice(0,1500);\n}catch(e){\n  detalle='Documento indexado, pero no se pudo clasificar ni resumir con IA: '+(e.message||'respuesta inesperada');\n}\nreturn [{json:{categoria,resumen,datos,detalle}}];"
      },
      "id": "n-parse",
      "name": "Parsear clasificación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2080,
        700
      ]
    }
  ],
