    {
      "parameters": {
        "jsCode": "const filas=$('Leer documentos').all().map(i=>i.json).filter(d=>d.file_id);\nconst nombres=$('Leer repos').all().map(i=>i.json.nombre).filter(Boolean);\nconst ext=n=>(String(n||'').split('.').pop()||'').toUpperCase();\nconst documentos=filas.map(d=>{let datos={};try{datos=d.datos?JSON.parse(d.datos):{}}catch(e){}\n  return {id:d.file_id,nombre:d.nombre,repo:d.repo||'General',tipo:d.tipo||ext(d.nombre),\n    estado:d.estado==='pendiente'?'procesando':(d.estado||'procesando'),categoria:d.categoria||'',\n    fecha:String(d.fecha||'').slice(0,10),resumen:d.resumen||'',datos,detalle:d.detalle||''}});\ndocumentos.sort((a,b)=>String(b.fecha).localeCompare(String(a.fecha)));\nconst repos=[...new Set([...(nombres.length?nombres:['General']),...documentos.map(d=>d.repo)])];\nreturn [{json:{documentos,repos}}];"
      },
