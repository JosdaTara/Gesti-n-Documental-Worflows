    {
      "parameters": {
        "jsCode": "const j=$('Webhook').first();\nconst w=j.json;\nconst tk=(w.headers.authorization||'').replace(/^Bearer\\s+/i,'');\nconst s=$('Leer sesiones').all().map(i=>i.json).find(x=>x.token&&x.token===tk&&new Date(x.expira)>new Date());\nconst accion=w.body.accion;\nlet error='';\nif(!s)error='Sesión no válida o vencida. Inicia sesión de nuevo.';\nelse if(accion==='eliminar'&&s.rol!=='admin')error='Solo un administrador puede eliminar documentos.';\nreturn [{json:{valido:!error,error,usuario:s?s.usuario:'',rol:s?s.rol:'',accion},binary:j.binary}];"
      },
