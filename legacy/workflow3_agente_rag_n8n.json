      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://TU-URL-DE-QDRANT:6333/collections/documentos_rag/points/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({ vector: $json.embedding.values, limit: 6, with_payload: true }, $('Validar sesión').first().json.repo ? { filter: { must: [ { key: 'metadata.repo', match: { value: $('Validar sesión').first().json.repo } } ] } } : {})) }}",
        "options": {}
      },
      "id": "a13",
      "name": "Buscar fragmentos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1440,
        720
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const v=$('Validar sesión').first().json;\nconst hits=Array.isArray($json.result)?$json.result:[];\nconst frags=hits.map((h,i)=>({\n  n:i+1,\n  archivo:(h.payload&&h.payload.metadata&&h.payload.metadata.archivo)||'Documento',\n  texto:String((h.payload&&h.payload.text)||'').slice(0,1500)\n}));\nif(!v.pregunta||!frags.length)return [{json:{prompt:'',fuentes:[],vacia:true}}];\nconst contexto=frags.map(f=>'[Fragmento '+f.n+'] Archivo: '+f.archivo+'\\n'+f.texto).join('\\n\\n');\nconst prompt='Eres el asistente de un repositorio documental. Responde en español usando SOLO la información de los fragmentos. Si la respuesta no está en los fragmentos, dilo con claridad.\\n\\nFragmentos:\\n'+contexto+'\\n\\nPregunta: '+v.pregunta;\nconst fuentes=[...new Map(frags.map(f=>[f.archivo,{archivo:f.archivo}])).values()];\nreturn [{json:{prompt,fuentes,vacia:false}}];"
      },
      "id": "a14",
      "name": "Armar prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        720
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents:[{ role:'user', parts:[{ text: $json.prompt }] }], generationConfig:{ temperature:0.3 } }) }}",
        "options": {}
      },
      "id": "a15",
      "name": "Gemini responde",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        720
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const prev=$('Armar prompt').first().json;\nif(prev.vacia)return [{json:{respuesta:'No encontré fragmentos relevantes en los documentos para responder esa pregunta.',fuentes:[]}}];\nlet respuesta='';\ntry{\n  const c=$json.candidates;\n  if(Array.isArray(c)&&c[0]&&c[0].content&&Array.isArray(c[0].content.parts))\n    respuesta=c[0].content.parts.map(p=>(p&&p.text)||'').join('').trim();\n}catch(e){}\nif(!respuesta)respuesta='La IA no pudo generar una respuesta en este momento. Intenta de nuevo.';\nreturn [{json:{respuesta,fuentes:prev.fuentes||[]}}];"
      },
      "id": "a16",
      "name": "Armar respuesta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        720
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "a17",
      "name": "Responder consulta",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        2400,
        720
      ]
    }
