# Base de datos (Supabase -> Connect -> Transaction pooler, puerto 6543; prefijo postgresql+psycopg://)
DATABASE_URL=postgresql+psycopg://postgres.REF:CLAVE@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Desarrollo local sin Postgres: DATABASE_URL=sqlite:///./local.db

# Supabase Storage
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
SUPABASE_BUCKET=documentos

# LLM
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.8-flash
# Segundo modelo con la misma clave (plan B cuando el principal esta saturado). Vacio = desactivado
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile
# Ollama local (opcional, plan B sin internet). Vacio = desactivado
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1
# Orden del plan B: se usan solo los que tengan clave/URL
LLM_PROVIDERS=gemini,gemini_lite,groq,ollama
CHAT_HISTORY_TURNS=10
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Auth
# En produccion (APP_ENV=production) la app NO arranca si JWT_SECRET es el valor por defecto o mide < 32
JWT_SECRET=change-me-to-a-long-random-string
# Contrasena inicial del usuario admin (obligatoria en produccion; en dev se usa una de prueba)
ADMIN_PASSWORD=
JWT_EXPIRE_MINUTES=480

# App
APP_ENV=dev
ALLOWED_ORIGINS=http://localhost:5500,http://localhost:8000
INDEXER_CRON_MINUTES=5
CONFIDENCE_THRESHOLD=0.85

# Modulo de vision (facturas)
VISION_PROVIDERS=gemini,gemini_lite,groq,ollama
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
OLLAMA_VISION_MODEL=llama3.2-vision
# local | anonimizado (requiere Tesseract) | externo (requiere autorizacion del usuario)
VISION_PRIVACY_MODE=anonimizado
VISION_MAX_MB=10

# Flujo procesar_factura (reglas de control)
MONTO_APROBACION=5000000
MONTO_ATIPICO_FACTOR=3

# Motor de automatizacion
SCHEDULER_ENABLED=true
RETRY_ATTEMPTS=3
RETRY_WAIT_SECONDS=1
CRON_SECRET=genera-un-token-largo-aleatorio
